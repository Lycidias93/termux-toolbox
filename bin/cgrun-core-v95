#!/usr/bin/env bash
# AUTOCLIP_V95_CGRUN_CORE
# AUTOCLIP_V95_STDIN_CLOSED
# AUTOCLIP_V95_OUTERMOST_CLIPBOARD_OWNER
# AUTOCLIP_V95_EXACT_RUN_BINDING_V2
# AUTOCLIP_V95_ARGV_EXEC_V1
set -uo pipefail

HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
OUT_DIR="${CG_OUTPUT_DIR:-$HOME_DIR/.chatgpt-output}"
TIMEOUT_SECONDS="${CGRUN_TIMEOUT_SECONDS:-0}"
HEARTBEAT_SECONDS="${CGRUN_HEARTBEAT_SECONDS:-10}"
HEARTBEAT_TAIL_LINES="${CGRUN_HEARTBEAT_TAIL_LINES:-12}"
TASK_LABEL="${CG_RUN_TASK:-${CGRUN_TASK_LABEL:-direct-cgrun}}"
RUN_ID="${CG_RUN_ID:-none}"
EXECUTION_ID="${CGRUN_EXECUTION_ID:-${RUN_ID:-none}}"
STDIN_MODE="dev-null"
NESTED_CLIPBOARD_SINK="${CGRUN_NESTED_CLIPBOARD_SINK:-/dev/null}"
BOUND_LOG_PATH="${CGRUN_BOUND_LOG_PATH:-}"
CORE_RECEIPT_PATH="${CGRUN_CORE_RECEIPT_PATH:-}"
LOG=""

is_uint() {
	case "${1:-}" in
	'' | *[!0-9]*) return 1 ;;
	*) return 0 ;;
	esac
}

write_core_receipt() {
	[ -n "$CORE_RECEIPT_PATH" ] || return 0
	mkdir -p "$(dirname "$CORE_RECEIPT_PATH")" 2>/dev/null || true
	{
		printf 'core_receipt_version=v2\n'
		printf 'execution_id=%s\n' "${EXECUTION_ID:-none}"
		printf 'run_id=%s\n' "$RUN_ID"
		printf 'log_path=%s\n' "${LOG:-missing}"
		printf 'input_mode=%s\n' "${INPUT_MODE:-unknown}"
		printf 'timed_out=%s\n' "${TIMED_OUT:-no}"
		printf 'command_exit_code=%s\n' "${COMMAND_EXIT_CODE:-2}"
		printf 'outcome=%s\n' "${OUTCOME:-core_failed}"
	} >"$CORE_RECEIPT_PATH" 2>/dev/null || true
}

fail() {
	local reason="$1"
	printf 'FAIL: %s\n' "$reason" >&2
	if [ -n "${LOG:-}" ]; then
		{
			printf 'FAIL: %s\n' "$reason"
			printf 'RESULT: CGRUN_CORE_FAILED outcome=%s command_exit_code=2\n' "$reason"
		} >>"$LOG" 2>/dev/null || true
	fi
	INPUT_MODE="${INPUT_MODE:-unknown}"
	TIMED_OUT="no"
	COMMAND_EXIT_CODE=2
	OUTCOME="$reason"
	write_core_receipt
	printf 'RESULT: CGRUN_CORE_FAILED outcome=%s command_exit_code=2\n' "$reason" >&2
	(exit 2)
}

mkdir -p "$OUT_DIR"
if [ -n "$BOUND_LOG_PATH" ]; then
	LOG="$BOUND_LOG_PATH"
else
	STAMP="$(date +%Y%m%d_%H%M%S)"
	LOG="$OUT_DIR/cgrun_${STAMP}_$$.log"
fi
mkdir -p "$(dirname "$LOG")"
: >"$LOG" || fail "log_create_failed path=$LOG"

is_uint "$TIMEOUT_SECONDS" || fail "timeout_invalid value=$TIMEOUT_SECONDS"
is_uint "$HEARTBEAT_SECONDS" || fail "heartbeat_invalid value=$HEARTBEAT_SECONDS"
is_uint "$HEARTBEAT_TAIL_LINES" || fail "heartbeat_tail_invalid value=$HEARTBEAT_TAIL_LINES"
[ -r "$NESTED_CLIPBOARD_SINK" ] || fail "nested_clipboard_sink_unreadable path=$NESTED_CLIPBOARD_SINK"

INPUT_MODE="legacy-shell"
COMMAND_TEXT=""
COMMAND_ARGC=0
if [ "${1:-}" = "--shell" ]; then
	shift
	[ "$#" -eq 1 ] || fail "shell_mode_requires_one_command_string"
	INPUT_MODE="shell"
	COMMAND_TEXT="$1"
elif [ "${1:-}" = "--exec" ]; then
	shift
	[ "$#" -gt 0 ] || fail "exec_mode_command_missing"
	INPUT_MODE="exec"
	COMMAND_ARGC="$#"
else
	[ "$#" -gt 0 ] || fail "command_missing"
	COMMAND_TEXT="$*"
fi

START_EPOCH="$(date +%s)"
TIMED_OUT="no"
{
	printf '%s\n' '== cgrun metadata =='
	date -Is 2>/dev/null || date
	printf 'pwd=%s\n' "$PWD"
	printf 'execution_id=%s\n' "$EXECUTION_ID"
	printf 'log=%s\n' "$LOG"
	printf 'timeout_seconds=%s\n' "$TIMEOUT_SECONDS"
	printf 'heartbeat_seconds=%s\n' "$HEARTBEAT_SECONDS"
	printf 'stdin_mode=%s\n' "$STDIN_MODE"
	printf 'input_mode=%s\n' "$INPUT_MODE"
	printf 'command_argc=%s\n' "$COMMAND_ARGC"
	printf 'task=%s\n' "$TASK_LABEL"
	printf 'run_id=%s\n' "$RUN_ID"
	printf '%s\n' 'nested_autocopy_owner=outermost'
	printf '\n'
} >>"$LOG"

launch_payload() {
	if [ "$INPUT_MODE" = "exec" ]; then
		if [ "$TIMEOUT_SECONDS" -gt 0 ]; then
			command -v timeout >/dev/null 2>&1 || fail "timeout_command_missing"
			CGRUN_CLIPBOARD_COMMAND="$NESTED_CLIPBOARD_SINK" CG_HANDOFF_CLIPBOARD_COMMAND="$NESTED_CLIPBOARD_SINK" timeout --foreground --signal=TERM --kill-after=5 "${TIMEOUT_SECONDS}s" "$@" </dev/null >>"$LOG" 2>&1 &
		else
			CGRUN_CLIPBOARD_COMMAND="$NESTED_CLIPBOARD_SINK" CG_HANDOFF_CLIPBOARD_COMMAND="$NESTED_CLIPBOARD_SINK" "$@" </dev/null >>"$LOG" 2>&1 &
		fi
	else
		if [ "$TIMEOUT_SECONDS" -gt 0 ]; then
			command -v timeout >/dev/null 2>&1 || fail "timeout_command_missing"
			CGRUN_CLIPBOARD_COMMAND="$NESTED_CLIPBOARD_SINK" CG_HANDOFF_CLIPBOARD_COMMAND="$NESTED_CLIPBOARD_SINK" timeout --foreground --signal=TERM --kill-after=5 "${TIMEOUT_SECONDS}s" bash -lc "$COMMAND_TEXT" </dev/null >>"$LOG" 2>&1 &
		else
			CGRUN_CLIPBOARD_COMMAND="$NESTED_CLIPBOARD_SINK" CG_HANDOFF_CLIPBOARD_COMMAND="$NESTED_CLIPBOARD_SINK" bash -lc "$COMMAND_TEXT" </dev/null >>"$LOG" 2>&1 &
		fi
	fi
}

if [ "$INPUT_MODE" = "exec" ]; then launch_payload "$@"; else launch_payload; fi
PAYLOAD_PID=$!

emit_heartbeat() {
	local now elapsed bytes lines
	now="$(date +%s)"; elapsed=$((now - START_EPOCH)); bytes="$(wc -c <"$LOG" | tr -d '[:space:]')"; lines="$(wc -l <"$LOG" | tr -d '[:space:]')"
	printf '\n%s\n' '== cgrun heartbeat =='
	date -Is 2>/dev/null || date
	printf 'phase=payload_running pid=%s alive=yes elapsed_seconds=%s log_bytes=%s log_lines=%s execution_id=%s\n' "$PAYLOAD_PID" "$elapsed" "$bytes" "$lines" "$EXECUTION_ID"
	printf '%s\n' '-- log tail --'
	tail -n "$HEARTBEAT_TAIL_LINES" "$LOG" 2>/dev/null || true
}

if [ "$HEARTBEAT_SECONDS" -gt 0 ]; then emit_heartbeat; fi
NEXT_HEARTBEAT=$HEARTBEAT_SECONDS
while kill -0 "$PAYLOAD_PID" 2>/dev/null; do
	sleep 1
	if [ "$HEARTBEAT_SECONDS" -gt 0 ]; then
		NOW="$(date +%s)"; ELAPSED=$((NOW - START_EPOCH))
		if [ "$ELAPSED" -ge "$NEXT_HEARTBEAT" ]; then emit_heartbeat; NEXT_HEARTBEAT=$((NEXT_HEARTBEAT + HEARTBEAT_SECONDS)); fi
	fi
done

set +e
wait "$PAYLOAD_PID"
COMMAND_EXIT_CODE=$?
set -e
case "$COMMAND_EXIT_CODE" in 124 | 137) [ "$TIMEOUT_SECONDS" -gt 0 ] && TIMED_OUT="yes" ;; esac

# Compatibility pointer only; internal evidence is bound to LOG/execution_id.
ln -sfn "$LOG" "$OUT_DIR/latest.log" 2>/dev/null || cp "$LOG" "$OUT_DIR/latest.log"
if [ "$TIMED_OUT" = "yes" ]; then OUTCOME="timed_out"; elif [ "$COMMAND_EXIT_CODE" -eq 0 ]; then OUTCOME="success"; else OUTCOME="command_failed"; fi
write_core_receipt

printf '\n%s\n' '== cgrun core result =='
printf 'execution_id=%s\ncommand_exit_code=%s\ntimed_out=%s\nstdin_mode=%s\ninput_mode=%s\nlog=%s\nlatest=%s\n' "$EXECUTION_ID" "$COMMAND_EXIT_CODE" "$TIMED_OUT" "$STDIN_MODE" "$INPUT_MODE" "$LOG" "$OUT_DIR/latest.log"
printf 'RESULT: CGRUN_CORE_DONE outcome=%s command_exit_code=%s timed_out=%s stdin_mode=%s input_mode=%s execution_id=%s\n' "$OUTCOME" "$COMMAND_EXIT_CODE" "$TIMED_OUT" "$STDIN_MODE" "$INPUT_MODE" "$EXECUTION_ID"
(exit "$COMMAND_EXIT_CODE")
