#!/usr/bin/env bash
set -euo pipefail

VERSION="cg-handoff-v1.1"
DOWNLOAD_ROOT="${CG_HANDOFF_DOWNLOAD_ROOT:-/storage/emulated/0/Download}"
TMP_ROOT="${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}"
HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
OUTPUT_ROOT="${CG_OUTPUT_DIR:-$HOME_DIR/.chatgpt-output}"
STAMP="$(date +%Y%m%d_%H%M%S)"
PREFLIGHT_LOG="$OUTPUT_ROOT/cg_handoff_preflight_${STAMP}_$$.log"
AUTOCOPY_LOG="$OUTPUT_ROOT/cg_handoff_autocopy_${STAMP}_$$.log"
lane="unbound"
scope="unknown"
host="unknown"
route_class="unknown"
secret_class="unknown"
bundle_work=""

mkdir -p "$OUTPUT_ROOT" "$TMP_ROOT" 2>/dev/null || true
: >"$PREFLIGHT_LOG" 2>/dev/null || true

# CG_HANDOFF_EARLY_AUTOCOPY_V1
write_failure_autocopy() {
	local reason="$1" copy_mode="full" clipboard_rc=127 clip_command
	case "${secret_class:-unknown}" in
	none | public | redacted) copy_mode="full" ;;
	*) copy_mode="redacted" ;;
	esac

	{
		printf '%s\n' '== cg-handoff early failure AutoCopy =='
		printf 'time=%s\n' "$(date -Is)"
		printf 'handoff_version=%s\n' "$VERSION"
		printf 'lane=%s\n' "${lane:-unbound}"
		printf 'scope=%s\n' "${scope:-unknown}"
		printf 'host=%s\n' "${host:-unknown}"
		printf 'route_class=%s\n' "${route_class:-unknown}"
		printf 'secret_class=%s\n' "${secret_class:-unknown}"
		printf 'reason=%s\n' "$reason"
		printf 'copy_mode=%s\n' "$copy_mode"
		if [[ "$copy_mode" == "full" ]]; then
			printf '%s\n' 'raw_handoff_suppressed=no'
			if [[ -s "$PREFLIGHT_LOG" ]]; then
				printf '%s\n' '== preflight transcript =='
				cat "$PREFLIGHT_LOG"
			fi
		else
			printf '%s\n' 'raw_handoff_suppressed=yes'
		fi
		printf 'FAIL: cg_handoff reason=%s\n' "$reason"
		printf 'RESULT: CG_HANDOFF_STOP outcome=stop reason=%s workflow_exit_code=2\n' "$reason"
	} >"$AUTOCOPY_LOG" 2>/dev/null || return 0

	clip_command="${CG_HANDOFF_CLIPBOARD_COMMAND:-${CGRUN_CLIPBOARD_COMMAND:-}}"
	if [[ -n "$clip_command" ]]; then
		if bash "$clip_command" <"$AUTOCOPY_LOG"; then
			clipboard_rc=0
		else
			clipboard_rc=$?
		fi
	elif command -v termux-clipboard-set >/dev/null 2>&1; then
		if command -v timeout >/dev/null 2>&1; then
			if timeout 10 termux-clipboard-set <"$AUTOCOPY_LOG"; then
				clipboard_rc=0
			else
				clipboard_rc=$?
			fi
		elif termux-clipboard-set <"$AUTOCOPY_LOG"; then
			clipboard_rc=0
		else
			clipboard_rc=$?
		fi
	fi

	printf 'RESULT: CG_HANDOFF_EARLY_AUTOCOPY_DONE clipboard_exit_code=%s mode=%s source=%s reason=%s\n' \
		"$clipboard_rc" "$copy_mode" "$AUTOCOPY_LOG" "$reason" >&2
	return 0
}

cleanup_bundle() {
	if [[ -n "${bundle_work:-}" ]]; then
		rm -rf -- "$bundle_work" 2>/dev/null || true
	fi
}

fail() {
	local reason="$1"
	printf 'FAIL: cg_handoff reason=%s\n' "$reason" >&2
	printf 'RESULT: CG_HANDOFF_STOP outcome=stop reason=%s workflow_exit_code=2\n' "$reason" >&2
	write_failure_autocopy "$reason" || true
	if declare -F drain_pending_tty_input >/dev/null 2>&1; then
		drain_pending_tty_input || true
	fi
	cleanup_bundle
	exit 2
}

usage() {
	printf 'Usage: cg-handoff <pixel_local__artifact.sh|bundle.zip|absolute-download-path> <sha256>\n' >&2
}

field() {
	local key="$1" file="$2" count value
	count="$(grep -Fc "# cg_handoff_${key}=" "$file" 2>/dev/null || true)"
	[[ "$count" == "1" ]] || fail "metadata_${key}_not_unique"
	value="$(sed -n "s/^# cg_handoff_${key}=//p" "$file")"
	[[ -n "$value" ]] || fail "metadata_${key}_empty"
	printf '%s\n' "$value"
}

manifest_field() {
	local key="$1" file="$2" count value
	count="$(grep -Ec "^${key}=" "$file" 2>/dev/null || true)"
	[[ "$count" == "1" ]] || fail "bundle_manifest_${key}_not_unique"
	value="$(sed -n "s/^${key}=//p" "$file")"
	[[ -n "$value" ]] || fail "bundle_manifest_${key}_empty"
	printf '%s\n' "$value"
}

safe_token() {
	local value="$1"
	[[ "$value" =~ ^[A-Za-z0-9._-]+$ ]]
}

safe_bundle_name() {
	local value="$1"
	[[ "$value" =~ ^[A-Za-z0-9._+-]+$ ]]
}

run_preflight() {
	local output rc
	set +e
	output="$("$@" 2>&1)"
	rc=$?
	set -e
	if [[ -n "$output" ]]; then
		printf '%s\n' "$output"
		printf '%s\n' "$output" >>"$PREFLIGHT_LOG" 2>/dev/null || true
	fi
	return "$rc"
}

# CG_HANDOFF_TTY_TAIL_DRAIN_V2
drain_pending_tty_input() {
	local tty="${CG_HANDOFF_TTY_PATH:-/dev/tty}"
	local drained=0 polls=0 quiet=0
	local max_bytes="${CG_HANDOFF_TTY_MAX_BYTES:-4096}"
	local max_polls="${CG_HANDOFF_TTY_MAX_POLLS:-30}"
	local quiet_polls="${CG_HANDOFF_TTY_QUIET_POLLS:-12}"
	local poll_timeout="${CG_HANDOFF_TTY_POLL_TIMEOUT:-0.05}"

	[[ "${CG_HANDOFF_TTY_DRAIN:-1}" == "1" ]] || return 0
	[[ -r "$tty" && -w "$tty" ]] || return 0
	[[ "$max_bytes" =~ ^[0-9]+$ && "$max_polls" =~ ^[0-9]+$ && "$quiet_polls" =~ ^[0-9]+$ ]] || return 0
	((max_bytes > 0 && max_polls > 0 && quiet_polls > 0)) || return 0

	exec 9<>"$tty" 2>/dev/null || return 0
	while ((polls < max_polls && drained < max_bytes)); do
		polls=$((polls + 1))
		if IFS= read -r -s -n 1 -t "$poll_timeout" <&9; then
			drained=$((drained + 1))
			quiet=0
			while ((drained < max_bytes)) && IFS= read -r -s -n 1 -t 0.001 <&9; do
				drained=$((drained + 1))
			done
		else
			quiet=$((quiet + 1))
			((quiet >= quiet_polls)) && break
		fi
	done
	exec 9<&- 9>&- 2>/dev/null || true

	if ((drained > 0)); then
		printf 'CG_HANDOFF_TTY_DRAIN bytes=%s polls=%s result=PASS\n' "$drained" "$polls"
	fi
}

# CG_HANDOFF_BUNDLE_V1
prepare_bundle_entrypoint() {
	local source="$1" outer_sha="$2"
	local zip_copy extract_dir manifest list_file duplicate entrypoint member_count entry_mode
	local i name size sha actual_size actual_sha expected_entries observed_entries found_entry=no

	for command in unzip mktemp sort uniq wc tr cut install chmod; do
		command -v "$command" >/dev/null 2>&1 || fail "command_missing_${command}"
	done

	mkdir -p "$TMP_ROOT"
	bundle_work="$(mktemp -d "$TMP_ROOT/cg-handoff-bundle.XXXXXX")" || fail bundle_private_dir_failed
	zip_copy="$bundle_work/bundle.zip"
	extract_dir="$bundle_work/extracted"
	manifest="$extract_dir/BUNDLE_MANIFEST.txt"
	list_file="$bundle_work/members.list"
	mkdir -p "$extract_dir" || fail bundle_extract_dir_failed

	install -m 0600 "$source" "$zip_copy" || fail bundle_stage_copy_failed
	[[ "$(sha256sum "$zip_copy" | awk '{print $1}')" == "$outer_sha" ]] || fail bundle_stage_sha_mismatch
	unzip -tq "$zip_copy" >/dev/null 2>&1 || fail bundle_zip_integrity_failed
	unzip -Z1 "$zip_copy" >"$list_file" 2>/dev/null || fail bundle_member_list_failed
	[[ -s "$list_file" ]] || fail bundle_member_list_empty

	while IFS= read -r name; do
		[[ -n "$name" ]] || fail bundle_member_name_empty
		safe_bundle_name "$name" || fail bundle_member_name_unsafe
	done <"$list_file"

	duplicate="$(sort "$list_file" | uniq -d | head -n1 || true)"
	[[ -z "$duplicate" ]] || fail bundle_duplicate_member
	[[ "$(grep -Fxc 'BUNDLE_MANIFEST.txt' "$list_file")" == "1" ]] || fail bundle_manifest_missing_or_duplicate

	unzip -q "$zip_copy" -d "$extract_dir" || fail bundle_extract_failed
	[[ -s "$manifest" ]] || fail bundle_manifest_missing

	[[ "$(manifest_field bundle_format_version "$manifest")" == "1" ]] || fail bundle_format_version_unsupported
	entrypoint="$(manifest_field entrypoint "$manifest")"
	entry_mode="$(manifest_field entrypoint_mode "$manifest")"
	member_count="$(manifest_field member_count "$manifest")"
	[[ "$member_count" =~ ^[0-9]+$ ]] || fail bundle_member_count_invalid
	((member_count >= 1 && member_count <= 64)) || fail bundle_member_count_out_of_range
	safe_bundle_name "$entrypoint" || fail bundle_entrypoint_name_unsafe
	case "$entrypoint" in
	pixel_local__*.sh) ;;
	*) fail bundle_entrypoint_basename_invalid ;;
	esac
	case "$entry_mode" in
	verify | run) ;;
	*) fail bundle_entrypoint_mode_invalid ;;
	esac

	expected_entries=$((member_count + 1))
	observed_entries="$(wc -l <"$list_file" | tr -d '[:space:]')"
	[[ "$observed_entries" == "$expected_entries" ]] || fail bundle_unexpected_member_count

	for ((i = 1; i <= member_count; i++)); do
		name="$(manifest_field "member_${i}_name" "$manifest")"
		size="$(manifest_field "member_${i}_size" "$manifest")"
		sha="$(manifest_field "member_${i}_sha256" "$manifest")"
		safe_bundle_name "$name" || fail "bundle_member_${i}_name_unsafe"
		[[ "$size" =~ ^[0-9]+$ ]] || fail "bundle_member_${i}_size_invalid"
		[[ "$sha" =~ ^[0-9a-f]{64}$ ]] || fail "bundle_member_${i}_sha_invalid"
		[[ "$(grep -Fxc "$name" "$list_file")" == "1" ]] || fail "bundle_member_${i}_archive_binding_failed"
		[[ -f "$extract_dir/$name" && -s "$extract_dir/$name" ]] || fail "bundle_member_${i}_missing"
		actual_size="$(wc -c <"$extract_dir/$name" | tr -d '[:space:]')"
		actual_sha="$(sha256sum "$extract_dir/$name" | awk '{print $1}')"
		[[ "$actual_size" == "$size" ]] || fail "bundle_member_${i}_size_mismatch"
		[[ "$actual_sha" == "$sha" ]] || fail "bundle_member_${i}_sha_mismatch"
		if [[ "$name" == "$entrypoint" ]]; then
			found_entry=yes
		fi
	done
	[[ "$found_entry" == yes ]] || fail bundle_entrypoint_not_manifest_member
	chmod 0700 "$extract_dir/$entrypoint" || fail bundle_entrypoint_chmod_failed
	bash -n "$extract_dir/$entrypoint" || fail bundle_entrypoint_syntax_failed
	printf 'CG_HANDOFF_BUNDLE_V1 outer=%s private_root=%s entrypoint=%s members=%s\n' \
		"$source" "$extract_dir" "$entrypoint" "$member_count"
	BUNDLE_ENTRY_MODE="$entry_mode"
	BUNDLE_ENTRYPOINT="$extract_dir/$entrypoint"
}

# CG_HANDOFF_SOURCE_RESCUE_V1
try_source_rescue() {
	local output rc marker_count marker rescue_root rescue_basename rescue_sha rescued_real rescue_root_real
	[[ "$source_arg" != /* ]] || return 1
	case "$source_arg" in
	pixel_local__*.sh | *.zip) ;;
	*) return 1 ;;
	esac
	command -v cgbootstrap >/dev/null 2>&1 || return 1

	set +e
	output="$(cgbootstrap source-rescue "$source_arg" "$expected_sha" 2>&1)"
	rc=$?
	set -e
	if [[ -n "$output" ]]; then
		printf '%s\n' "$output"
		printf '%s\n' "$output" >>"$PREFLIGHT_LOG" 2>/dev/null || true
	fi
	((rc == 0)) || return 1
	marker_count="$(printf '%s\n' "$output" | grep -Fc 'RESULT: TERMUX_BOOTSTRAP_SOURCE_RESCUE_DONE ')"
	[[ "$marker_count" == 1 ]] || return 1
	marker="$(printf '%s\n' "$output" | grep -F 'RESULT: TERMUX_BOOTSTRAP_SOURCE_RESCUE_DONE ' | head -n 1)"
	[[ "$marker" == *' state=pass '* && "$marker" == *' workflow_exit_code=0' ]] || return 1
	rescue_root="$(printf '%s\n' "$marker" | sed -n 's/.* source_rescue_root=\([^ ]*\).*/\1/p')"
	rescue_basename="$(printf '%s\n' "$marker" | sed -n 's/.* basename=\([^ ]*\).*/\1/p')"
	rescue_sha="$(printf '%s\n' "$marker" | sed -n 's/.* sha256=\([0-9a-f][0-9a-f]*\).*/\1/p')"
	[[ "$rescue_root" =~ ^/[A-Za-z0-9._/-]+$ && "$rescue_root" != *'/../'* && "$rescue_root" != *'/..' ]] || return 1
	[[ "$rescue_basename" == "$source_arg" && "$rescue_sha" == "$expected_sha" ]] || return 1
	[[ -f "$rescue_root/$source_arg" && -s "$rescue_root/$source_arg" ]] || return 1
	[[ "$(sha256sum "$rescue_root/$source_arg" | awk '{print $1}')" == "$expected_sha" ]] || return 1
	rescue_root_real="$(readlink -f "$rescue_root" 2>/dev/null || true)"
	rescued_real="$(readlink -f "$rescue_root/$source_arg" 2>/dev/null || true)"
	[[ -n "$rescue_root_real" && -n "$rescued_real" ]] || return 1
	case "$rescued_real" in
	"$rescue_root_real"/*) ;;
	*) return 1 ;;
	esac
	DOWNLOAD_ROOT="$rescue_root_real"
	source_path="$rescued_real"
	printf 'CG_HANDOFF_SOURCE_RESCUE_V1 state=pass provider=cgbootstrap basename=%s sha256=%s\n' "$source_arg" "$expected_sha"
	return 0
}

source_arg="${1:-}"
expected_sha="${2:-}"
[[ -n "$source_arg" && -n "$expected_sha" && "$#" -eq 2 ]] || {
	usage
	fail invalid_arguments
}
[[ "$expected_sha" =~ ^[0-9a-f]{64}$ ]] || fail expected_sha_invalid

case "$source_arg" in
/*) source_path="$source_arg" ;;
*) source_path="$DOWNLOAD_ROOT/$source_arg" ;;
esac

if [[ ! -f "$source_path" || ! -s "$source_path" ]]; then
	if ! try_source_rescue; then
		[[ -f "$source_path" ]] || fail source_missing
		fail source_empty
	fi
fi
[[ -f "$source_path" ]] || fail source_missing
[[ -s "$source_path" ]] || fail source_empty
source_real="$(readlink -f "$source_path" 2>/dev/null || true)"
download_real="$(readlink -f "$DOWNLOAD_ROOT" 2>/dev/null || true)"
[[ -n "$source_real" && -n "$download_real" ]] || fail source_realpath_failed
case "$source_real" in
"$download_real"/*) ;;
*) fail source_outside_download_root ;;
esac

basename="$(basename "$source_real")"
case "$basename" in
target-* | targets-*) fail remote_target_not_supported ;;
pixel_local__*.sh) artifact_kind=script ;;
*.zip) artifact_kind=bundle ;;
*) fail unsupported_artifact_basename ;;
esac

actual_sha="$(sha256sum "$source_real" | awk '{print $1}')"
[[ "$actual_sha" == "$expected_sha" ]] || fail source_sha_mismatch

if [[ "$artifact_kind" == bundle ]]; then
	prepare_bundle_entrypoint "$source_real" "$expected_sha"
	artifact_source="$BUNDLE_ENTRYPOINT"
else
	artifact_source="$source_real"
fi

start_count="$(grep -Fxc '# CG_HANDOFF_V1_START' "$artifact_source" 2>/dev/null || true)"
end_count="$(grep -Fxc '# CG_HANDOFF_V1_END' "$artifact_source" 2>/dev/null || true)"
[[ "$start_count" == "1" && "$end_count" == "1" ]] || fail metadata_block_not_unique

lane="$(field lane "$artifact_source")"
scope="$(field scope "$artifact_source")"
host="$(field host "$artifact_source")"
route_class="$(field route_class "$artifact_source")"
secret_class="$(field secret_class "$artifact_source")"
run_mode="$(field run_mode "$artifact_source")"
expected_marker="$(field expected_marker "$artifact_source")"

safe_token "$lane" || fail lane_invalid
safe_token "$host" || fail host_invalid
case "$scope" in
repo | pixel | pixel-dispatcher | pi3 | pi4 | berylax | pi-host-drop | dns-ha-route | pi4-takeout | zeropi2 | zeropi2-edge | omen) ;;
*) fail scope_invalid ;;
esac
case "$route_class" in
none | read-only | route | dns-ha | magicdns | subnet-route) ;;
*) fail route_class_invalid ;;
esac
case "$secret_class" in
none | public | redacted | possible | sensitive) ;;
*) fail secret_class_invalid ;;
esac
case "$run_mode" in
verify | run) ;;
*) fail run_mode_invalid ;;
esac
if [[ "$artifact_kind" == bundle && "$BUNDLE_ENTRY_MODE" != "$run_mode" ]]; then
	fail bundle_entrypoint_mode_metadata_mismatch
fi
[[ "${#expected_marker}" -le 500 ]] || fail expected_marker_too_long
[[ "$expected_marker" != *$'\r'* && "$expected_marker" != *$'\n'* ]] || fail expected_marker_control_char

for command in cgprep cclear cgcurrent cguse cg-run-file cglint bash install mv rm sha256sum readlink basename grep sed awk mkdir; do
	command -v "$command" >/dev/null 2>&1 || fail "command_missing_${command}"
done

run_preflight cgprep || fail cgprep_failed
run_preflight cclear || fail cclear_failed
run_preflight cgcurrent || fail cgcurrent_failed
run_preflight cguse "$lane" "$scope" "$host" "$route_class" "$secret_class" || fail cguse_failed

if [[ "$artifact_kind" == script ]]; then
	mkdir -p "$TMP_ROOT"
	dst="$TMP_ROOT/$basename"
	tmp="$dst.stage.$$"
	rm -f -- "$tmp"
	install -m 0700 "$artifact_source" "$tmp" || fail stage_install_failed
	staged_sha="$(sha256sum "$tmp" | awk '{print $1}')"
	[[ "$staged_sha" == "$expected_sha" ]] || fail stage_sha_mismatch
	bash -n "$tmp" || fail stage_syntax_failed
	mv -f -- "$tmp" "$dst" || fail stage_publish_failed
	published_sha="$(sha256sum "$dst" | awk '{print $1}')"
	[[ "$published_sha" == "$expected_sha" ]] || fail published_sha_mismatch
else
	dst="$artifact_source"
fi

# CG_HANDOFF_CGLINT_GATE_V1
run_preflight cglint "$dst" || fail cglint_gate_failed
printf "CG_HANDOFF_CGLINT_GATE_V1 state=pass mode=default artifact=%s\n" "$dst"

export CGFLOW_EXPECTED_MARKER="$expected_marker"
printf 'CG_HANDOFF_V1 source=%s staged=%s sha256=%s kind=%s lane=%s mode=%s scope=%s host=%s route_class=%s secret_class=%s\n' \
	"$source_real" "$dst" "$expected_sha" "$artifact_kind" "$lane" "$run_mode" "$scope" "$host" "$route_class" "$secret_class"

rm -f -- "$PREFLIGHT_LOG" 2>/dev/null || true
set +e
cg-run-file "$dst" "$run_mode" "$scope" "$host" "$route_class" "$secret_class"
run_rc=$?
set -e
drain_pending_tty_input || true
cleanup_bundle
exit "$run_rc"
