#!/usr/bin/env bash
set -uo pipefail

usage() {
	printf '%s\n' \
		'usage: cglint [--strict] FILE [FILE ...]' \
		'' \
		'Read-only shell artifact lint gate.' \
		'Runs the parser, ShellCheck and shfmt diff checks without modifying files.' \
		'Default mode blocks parser failures, ShellCheck errors/warnings and shfmt execution errors; formatting drift is warning-only.' \
		'--strict additionally blocks ShellCheck info/style findings and shfmt formatting drift.'
}

strict=no
if [[ "${1:-}" == "--strict" ]]; then
	strict=yes
	shift
fi

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
	usage
	[[ $# -gt 0 ]] && exit 0
	exit 2
fi

missing=0
for cmd in shellcheck shfmt; do
	if ! command -v "$cmd" >/dev/null 2>&1; then
		printf 'FAIL: dependency_missing command=%s\n' "$cmd" >&2
		missing=1
	fi
done
if [[ "$missing" -ne 0 ]]; then
	printf 'RESULT: CGLINT_BLOCKED outcome=dependency_missing workflow_exit_code=2\n' >&2
	exit 2
fi

severity=warning
mode=default
if [[ "$strict" == "yes" ]]; then
	severity=style
	mode=strict
fi

fail=0
checked=0
for file in "$@"; do
	if [[ ! -f "$file" ]]; then
		printf 'FAIL: file_missing path=%s\n' "$file" >&2
		fail=1
		continue
	fi

	shell="bash"
	first_line="$(
		IFS= read -r line <"$file"
		printf '%s' "$line"
	)"
	case "$first_line" in
	*'/dash' | *'/dash '* | *' env dash'*) shell="dash" ;;
	*'/ash' | *'/ash '* | *' env ash'*) shell="sh" ;;
	*'/bash' | *'/bash '* | *' env bash'*) shell="bash" ;;
	*'/sh' | *'/sh '* | *' env sh'*) shell="sh" ;;
	esac

	parser_rc=0
	if [[ "$shell" == "bash" ]]; then
		bash -n "$file" || parser_rc=$?
	else
		sh -n "$file" || parser_rc=$?
	fi
	if [[ "$parser_rc" -ne 0 ]]; then
		printf 'FAIL: parser path=%s shell=%s exit_code=%s\n' "$file" "$shell" "$parser_rc" >&2
		fail=1
		continue
	fi

	shellcheck_shell="$shell"
	[[ "$shellcheck_shell" == "dash" ]] && shellcheck_shell="sh"
	if ! shellcheck -S "$severity" -s "$shellcheck_shell" -- "$file"; then
		printf 'FAIL: shellcheck path=%s shell=%s severity=%s\n' "$file" "$shellcheck_shell" "$severity" >&2
		fail=1
		continue
	fi

	shfmt_lang="bash"
	case "$shell" in
	bash) shfmt_lang="bash" ;;
	dash | sh) shfmt_lang="posix" ;;
	esac
	shfmt_rc=0
	shfmt_output="$(shfmt -ln="$shfmt_lang" -d -- "$file")" || shfmt_rc=$?
	if [[ "$shfmt_rc" -ne 0 ]]; then
		if [[ "$shfmt_rc" -eq 1 && -n "$shfmt_output" ]]; then
			if [[ "$strict" == "yes" ]]; then
				printf '%s\n' "$shfmt_output"
				printf 'FAIL: shfmt_diff path=%s mode=strict\n' "$file" >&2
				fail=1
				continue
			fi
			printf 'WARN: shfmt_diff_nonblocking path=%s mode=default\n' "$file" >&2
		else
			printf 'FAIL: shfmt_error path=%s shell=%s shfmt_lang=%s exit_code=%s\n' "$file" "$shell" "$shfmt_lang" "$shfmt_rc" >&2
			fail=1
			continue
		fi
	fi

	checked=$((checked + 1))
	printf 'PASS: cglint path=%s shell=%s shfmt_lang=%s severity=%s\n' "$file" "$shell" "$shfmt_lang" "$severity"
done

if [[ "$fail" -ne 0 ]]; then
	printf 'RESULT: CGLINT_FAIL checked=%s workflow_exit_code=1 mode=%s\n' "$checked" "$mode" >&2
	exit 1
fi
printf 'RESULT: CGLINT_DONE checked=%s workflow_exit_code=0 mode=%s\n' "$checked" "$mode"
